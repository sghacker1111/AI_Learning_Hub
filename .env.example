# ==========================================
# AI Learning Nepal - Environment Variables
# ==========================================

# Application
NEXT_PUBLIC_APP_NAME="AI Learning Nepal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL with pgvector support)
# Neon runtime: copy the pooled connection URL from the Neon console.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_ENDPOINT-pooler.YOUR_REGION.aws.neon.tech/YOUR_DATABASE?sslmode=require&connect_timeout=15&pool_timeout=15"
# Prisma migrations: same database, with Connection pooling disabled in Neon.
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_ENDPOINT.YOUR_REGION.aws.neon.tech/YOUR_DATABASE?sslmode=require&connect_timeout=15"

# One-time real Super Admin bootstrap. Set privately; never commit filled values.
# Password: 16+ characters, upper/lowercase, number, symbol; at most 72 UTF-8 bytes.
# Run only when ready: npm run create-super-admin. Remove all three values afterward.
BOOTSTRAP_SUPERADMIN_EMAIL=""
BOOTSTRAP_SUPERADMIN_PASSWORD=""
BOOTSTRAP_SUPERADMIN_NAME=""

# Authentication (Auth.js / NextAuth / JWT)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development_secret_key_change_in_production_min_32_chars"
# Demo personas require explicit opt-in and are never enabled in production.
ALLOW_DEMO_AUTH="false"
DEMO_PASSWORD="password123"

# Seeding creates demo accounts and is blocked in production unless explicitly enabled.
ALLOW_DEMO_SEED="false"
SEED_DEMO_PASSWORD="replace-with-a-strong-development-password"

# AI Provider Configuration (Multi-provider server-side only)
# Options: qwen | openrouter | groq | ollama
AI_PROVIDER="qwen"
AI_BASE_URL="https://router.huggingface.co/v1"
AI_API_KEY=""
AI_MODEL="Qwen/Qwen3.5-122B-A10B:fastest"

# Secondary / Fallback Provider
AI_FALLBACK_PROVIDER="qwen"
AI_FALLBACK_BASE_URL="https://api.groq.com/openai/v1"
AI_FALLBACK_API_KEY=""
AI_FALLBACK_MODEL="Qwen/Qwen3-Next-80B-A3B-Instruct:fastest"

# Optional Ollama configuration (not used by the hosted default)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_IMAGE_PROMPT_MODEL="qwen3:8b"
AI_IMAGE_PROMPT_MODEL="Qwen/Qwen3.5-122B-A10B:fastest"
OLLAMA_THINKING="false"
OLLAMA_NUM_CTX="4096"
OLLAMA_KEEP_ALIVE="10m"
AI_IMAGE_PROMPT_ENHANCEMENT="true"
# Keep false for truthful provider failures. Enable only for explicitly labeled UI demos.
AI_ALLOW_SIMULATION="false"

# Educational image generation (server-side only)
# Hugging Face accounts receive limited monthly inference credits; this is not unlimited free compute.
AI_IMAGE_PROVIDER="huggingface"
AI_IMAGE_MODEL="Qwen/Qwen-Image-2512"
# auto lets Hugging Face select an available routed inference provider for the model.
AI_IMAGE_INFERENCE_PROVIDER="auto"
HF_TOKEN=""
# Optional: a private Hugging Face Inference Endpoint URL. Leave empty for routed providers.
AI_IMAGE_ENDPOINT=""
AI_IMAGE_TIMEOUT_MS="120000"
AI_IMAGE_RATE_LIMIT_PER_HOUR="8"
AI_IMAGE_STEPS="40"
AI_IMAGE_GUIDANCE_SCALE="4"

# Embeddings Configuration
EMBEDDING_PROVIDER="openai-compatible"
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"

# Python Math Service (Optional SymPy verification service)
MATH_SERVICE_URL="http://localhost:8000"
MATH_SERVICE_SECRET=""

# Billing gateways are a non-charging sandbox demonstration unless real,
# server-side gateway credentials and webhook verification are implemented.
PAYMENTS_DEMO_MODE="false"

# Docker Compose database settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_this_database_password"
POSTGRES_DB="ai_learning_nepal"

# LiveKit voice: web server only. Hosted setup guide: docs/LIVE-VOICE-SETUP.md
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
VOICE_AGENT_URL=""
# Same random 32+ character value on web server and voice worker.
VOICE_AGENT_SECRET=""
# Worker settings (also set these on its separate host/container).
GURU_WEB_URL=""
GROQ_API_KEY=""
# Optional when teacher audio is Browser speech only.
TTS_API_KEY=""
TTS_BASE_URL=""
TTS_MODEL=""
